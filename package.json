{
  "name": "@xie-work/xie-auth",
  "version": "1.4.5",
  "description": "嵌入式认证服务库：为第三方 Node.js 项目接管用户、注册、登录、鉴权与权限管理。链式 API 声明接口即可，文件存储、零外部运行时依赖。",
  "type": "module",
  "access": "public",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "build": "npm run type-check && vite build",
    "build:only": "vite build",
    "test": "node test/server.test.mjs",
    "test:build": "npm run build && npm run test",
    "clean": "rimraf dist",
    "prepublishOnly": "yarn build:only"
  },
  "keywords": [
    "auth",
    "authentication",
    "authorization",
    "session",
    "cookie",
    "rbac",
    "embeddable",
    "file-storage",
    "typescript",
    "node",
    "vite"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiechanglei/xie-auth.git"
  },
  "bugs": {
    "url": "https://github.com/xiechanglei/xie-auth/issues"
  },
  "homepage": "https://github.com/xiechanglei/xie-auth#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0"
  }
}
